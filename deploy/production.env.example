# Copy on the server to /root/kronos-strategy/.env.production.
# Do not commit the real file or disclose the generated password.
KRONOS_ENV=production
KRONOS_ADMIN_USERNAME=admin
KRONOS_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# Leave empty when the React SPA and API share the same origin.
# For a separately hosted frontend, use comma-separated explicit origins.
KRONOS_CORS_ORIGINS=
